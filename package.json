{
  "name": "medtravelcn",
  "type": "module",
  "version": "2.0.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "node scripts/export-db-to-search-index.mjs && node scripts/init-db.mjs && node scripts/migrate.mjs && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "db:export": "node scripts/export-db-to-search-index.mjs",
    "db:init": "node scripts/init-db.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:provenance": "node scripts/add-provenance.mjs",
    "db:verify": "node scripts/verify-sync.mjs",
    "db:reset": "rm -f data/medtravelcn.db && npm run db:init && npm run db:migrate"
  },
  "dependencies": {
    "@astrojs/node": "^11.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@vercel/kv": "^2.0.0",
    "astro": "^7.0.3",
    "better-sqlite3": "12.11.1",
    "typescript": "^6.0.3"
  }
}