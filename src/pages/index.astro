---
// src/pages/index.astro
// Homepage - dynamically renders city grid from SQLite
import Base from '~/layouts/Base.astro';
import CityCard from '~/components/CityCard.astro';
import { getAllCities, getHospitalCount, incrementView } from '~/lib/db';

// Track this page view
incrementView('home');

const cities = getAllCities();
const citiesWithCounts = cities.map(c => ({
  city: c,
  count: getHospitalCount(c.slug),
}));
---
<Base
  title="MedTravelCN.net — Medical Tourism to China"
  description={`Discover world-class medical care in China at a fraction of Western costs. Browse hospitals in ${cities.length} major cities, compare prices, and book your medical trip.`}
  page="home"
  showHero={true}
>
  <div class="intro" style="background: white; padding: 40px 30px; border-radius: 12px; margin-bottom: 30px; text-align: center;">
    <h2 style="margin-top: 0;">Why Choose China for Medical Treatment?</h2>
    <p style="max-width: 720px; margin: 0 auto; color: #555;">
      China offers internationally accredited hospitals (many JCI-certified), top-ranked specialists, and significant cost savings — typically 50-80% below US/UK prices with no wait times. English-speaking coordinators and direct hospital booking make the process smooth for international patients.
    </p>
  </div>

  <h2 id="cities">Browse Medical Tourism Cities</h2>
  <p>Explore {cities.length} major Chinese cities with verified international-standard hospitals:</p>
  <div class="city-grid">
    {citiesWithCounts.map(({ city, count }) => (
      <CityCard city={city} hospitalCount={count} />
    ))}
  </div>

  <h2 style="margin-top: 50px;">How It Works</h2>
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-top: 20px;">
    <div style="background: white; padding: 24px; border-radius: 10px; box-shadow: 0 2px 8px rgba(0,0,0,0.06);">
      <div style="font-size: 2em; color: #2980b9; font-weight: 700;">1</div>
      <h3 style="margin-top: 8px;">Browse Cities</h3>
      <p style="font-size: 0.92em;">Compare {cities.length} cities with verified hospitals, specialties, and cost ranges.</p>
    </div>
    <div style="background: white; padding: 24px; border-radius: 10px; box-shadow: 0 2px 8px rgba(0,0,0,0.06);">
      <div style="font-size: 2em; color: #2980b9; font-weight: 700;">2</div>
      <h3 style="margin-top: 8px;">Read Real Reviews</h3>
      <p style="font-size: 0.92em;">See verified patient experiences from people who actually received treatment.</p>
    </div>
    <div style="background: white; padding: 24px; border-radius: 10px; box-shadow: 0 2px 8px rgba(0,0,0,0.06);">
      <div style="font-size: 2em; color: #2980b9; font-weight: 700;">3</div>
      <h3 style="margin-top: 8px;">Contact Hospitals</h3>
      <p style="font-size: 0.92em;">Use direct phone numbers and websites. Most have English-speaking coordinators.</p>
    </div>
    <div style="background: white; padding: 24px; border-radius: 10px; box-shadow: 0 2px 8px rgba(0,0,0,0.06);">
      <div style="font-size: 2em; color: #2980b9; font-weight: 700;">4</div>
      <h3 style="margin-top: 8px;">Plan Your Trip</h3>
      <p style="font-size: 0.92em;">Coordinate travel, accommodation, and follow-up care with our guides.</p>
    </div>
  </div>
</Base>